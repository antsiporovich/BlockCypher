<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- System.Security.Cryptography.Pkcs 9.0.11 is pinned exactly by a transitive dependency
         of Microsoft.Data.SqlClient; Directory.Packages.props transitive pinning cannot override
         an exact upstream range. Demoted to warning (still visible), not suppressed. See README
         "known limitations" / docs/adr for the full note. Revisit when SqlClient bumps its floor. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1902;NU1903</WarningsNotAsErrors>
  </PropertyGroup>

</Project>
