<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- shortcut: deliberately NOT added to ICMarkets.BlockCypher.slnx and never
         referenced by `dotnet test` - this is a standalone NBomber load-testing
         tool you run manually against a live instance of the API, not part of
         the CI test suite. See README for how to run it. -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NBomber" />
  </ItemGroup>

  <!-- NBomber PackageReference is added by phase7-setup.ps1 via `dotnet add`,
       never written here by hand (Central Package Management). -->

</Project>
