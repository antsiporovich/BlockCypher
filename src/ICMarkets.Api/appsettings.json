{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "Sqlite"
  },
  "ConnectionStrings": {
    "Default": "Data Source=blockcypher.db"
  },
  "BlockCypher": {
    "BaseUrl": "https://api.blockcypher.com/v1/",
    "Networks": {
      "BtcMain": "btc/main",
      "EthMain": "eth/main",
      "DashMain": "dash/main",
      "BtcTest3": "btc/test3",
      "LtcMain": "ltc/main"
    }
  }
}
