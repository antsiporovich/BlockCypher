{
  "title": "ICMarkets Ingestion",
  "uid": "icmarkets-ingestion",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Snapshots ingested / min (by network)",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum by (network) (rate(icmarkets_snapshots_ingested_total[5m])) * 60",
          "legendFormat": "{{network}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Ingestion failures / min (by network)",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum by (network) (rate(icmarkets_ingestion_failures_total[5m])) * 60",
          "legendFormat": "{{network}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "BlockCypher fetch duration, p95 (ms, by network)",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, network) (rate(icmarkets_fetch_duration_milliseconds_bucket[5m])))",
          "legendFormat": "{{network}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "HTTP request rate",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "sum(rate(http_server_request_duration_seconds_count[5m]))",
          "legendFormat": "requests/s"
        }
      ]
    }
  ]
}
